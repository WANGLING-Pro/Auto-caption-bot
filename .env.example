# Get these from https://my.telegram.org
API_ID=1234567
API_HASH=your_api_hash_here

# Get this from @BotFather
BOT_TOKEN=123456:ABC-your-bot-token

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=caption_bot

# Comma-separated Telegram user IDs allowed to manage the bot
ADMINS=111111111,222222222

# Optional: username (no @) of a channel users must join before using the bot
FORCE_SUB_CHANNEL=

# Optional: numeric channel ID for internal logging (0 = disabled)
LOG_CHANNEL=0

BOT_NAME=AutoCaptionBot
